---
import DocSection from "./DocSection.astro";
---

<header class="pb-12" id="home">
  <div class="doc-frame px-[2ch] pt-[var(--doc-page-top)] sm:px-[4ch]">
    <h1 class="text-2xl font-normal leading-8 lowercase">ghost</h1>
    <p class="my-6 max-w-[54ch] rounded-squircle border border-[var(--doc-line)] px-[2ch] py-4 text-foreground">
      a brand context router for agents.
    </p>
  </div>
  <div class="doc-frame relative mt-8 px-[2ch] sm:px-[4ch]">
    <DocSection
      title="thesis"
      marker={0}
      labelAs="h2"
      class="py-12 first:pt-12"
    >
      <p class="max-w-[54ch]">
        You record your brand's design decisions and when they apply.
        Your agent selects the guidance for the task, and ghost delivers it
        before work begins.
      </p>
    </DocSection>
  </div>
</header>
